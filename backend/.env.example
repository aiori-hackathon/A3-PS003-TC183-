# FedTraffic backend configuration
# ---------------------------------------------------------------------------
# Render:  add these under Dashboard → your service → Environment
#          (render.yaml at the repo root already sets them for a Blueprint deploy).
# Local:   cp backend/.env.example backend/.env   (real environment variables override this file)
# No secrets are required: the app has no API keys or passwords.
# ---------------------------------------------------------------------------

# Port to listen on. Render sets PORT automatically; leave it unset there.
# PORT=8000

# Seed a fresh deployment with real results: on an empty database, queue the
# evaluation suite (centralized + FedAvg A, B, C, C2, D) at startup. ~3 min on 1 CPU.
FEDTRAFFIC_SEED_DEMO=1
FEDTRAFFIC_DEMO_ROUNDS=20
FEDTRAFFIC_TORCH_THREADS=1
FEDTRAFFIC_MAX_PENDING=30

# Allowed browser origins for the API, comma-separated.
# "*" is fine when the dashboard is served by this same service (Docker deploy).
# If the frontend is deployed separately (e.g. Render Static Site), list its URL:
#   FEDTRAFFIC_CORS_ORIGINS=https://fedtraffic-dashboard.onrender.com
FEDTRAFFIC_CORS_ORIGINS=*

# SQLite database (experiment history). Render's filesystem is wiped on every
# deploy/restart; to keep history, attach a persistent disk at /var/data (paid plans) and use:
#   FEDTRAFFIC_DB_PATH=/var/data/fedtraffic.db
# Default in Docker: /app/state/fedtraffic.db   Default locally: backend/fedtraffic.db
# FEDTRAFFIC_DB_PATH=

# Paths. The Dockerfile already sets these; locally the defaults are backend/data and frontend/dist.
# FEDTRAFFIC_DATA_DIR=/app/backend/data
# FEDTRAFFIC_FRONTEND_DIST=/app/frontend/dist
