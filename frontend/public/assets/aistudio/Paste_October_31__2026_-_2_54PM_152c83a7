<script>
  (function() {
    let currentRound = 34;
    let maxRounds = 100;
    let currentClients = 5;
    let currentAlpha = 0.5;
    let currentSeed = 42;
    let baseCommBytes = 6.0; // MB per round with 5 clients

    const roundValEl = document.getElementById('metric-round-val');
    const roundBarEl = document.getElementById('metric-round-bar');
    const maeValEl = document.getElementById('metric-mae-val');
    const commValEl = document.getElementById('metric-comm-val');
    const cursorRoundX = document.getElementById('cursor-round-x');
    const cursorRoundDot = document.getElementById('cursor-round-dot');
    const terminalEl = document.getElementById('telemetry-terminal');
    const sliderClients = document.getElementById('slider-client-count');
    const labelClients = document.getElementById('label-client-count');
    const distBtns = document.querySelectorAll('.dist-btn');
    const seedBtns = document.querySelectorAll('.seed-btn');
    const btnStep = document.getElementById('btn-fedavg-step');
    const btnFf10 = document.getElementById('btn-ff-10');
    const btnFf50 = document.getElementById('btn-ff-50');
    const btnReset = document.getElementById('btn-reset');
    const btnClearLogs = document.getElementById('btn-clear-logs');

    function appendLog(text, highlightType = 'normal') {
      const now = new Date();
      const timeStr = now.toTimeString().split(' ')[0] + '.' + String(now.getMilliseconds()).padStart(3, '0');
      const div = document.createElement('div');
      
      if (highlightType === 'success') {
        div.className = 'text-on-tertiary-container font-semibold';
        div.innerHTML = `[${timeStr}] ${text}`;
      } else if (highlightType === 'accent') {
        div.className = 'text-on-surface-variant';
        div.innerHTML = `[${timeStr}] <span class="text-secondary">${text}</span>`;
      } else {
        div.className = 'text-on-surface-variant';
        div.innerHTML = `[${timeStr}] ${text}`;
      }
      
      terminalEl.appendChild(div);
      terminalEl.scrollTop = terminalEl.scrollHeight;
    }

    function computeMetrics(r) {
      // Synthetic mathematically sound convergence formula
      // Centralized limit ~ 17.65
      // Non-IID penalty varies with alpha
      const alphaPenalty = currentAlpha === 0.1 ? 2.4 : (currentAlpha === 0.5 ? 0.8 : 0.2);
      const seedJitter = (Math.sin(currentSeed + r) * 0.12);
      const mae = (17.65 + alphaPenalty + 14 * Math.exp(-r / 18) + seedJitter).toFixed(2);
      const totalMB = ((r * (currentClients * 1.2))).toFixed(1);
      return { mae, totalMB };
    }

    function renderState() {
      roundValEl.textContent = currentRound;
      roundBarEl.style.width = `${Math.min(100, (currentRound / maxRounds) * 100)}%`;

      const { mae, totalMB } = computeMetrics(currentRound);
      maeValEl.textContent = mae;
      commValEl.textContent = totalMB;

      // Update Cursor position in convergence plot (45px to 520px)
      const xPos = 45 + ((currentRound - 1) / (maxRounds - 1)) * (520 - 45);
      cursorRoundX.setAttribute('x1', xPos);
      cursorRoundX.setAttribute('x2', xPos);
      cursorRoundDot.setAttribute('cx', xPos);

      // Y pos approximate mapping for non-IID curve
      const yPos = 195 - (195 - 81) * (1 - Math.exp(-currentRound / 24));
      cursorRoundDot.setAttribute('cy', yPos);

      // Random jitter for client losses
      const lossNodes = ['loss-node-a', 'loss-node-b', 'loss-node-c', 'loss-node-d', 'loss-node-e'];
      lossNodes.forEach((id, idx) => {
        const el = document.getElementById(id);
        if (el) {
          const l = (0.035 + (idx * 0.003) + 0.04 * Math.exp(-currentRound / 15) + (Math.random() * 0.002)).toFixed(4);
          el.textContent = l;
        }
      });
    }

    function stepRound(n = 1) {
      if (currentRound + n > maxRounds) {
        currentRound = maxRounds;
      } else {
        currentRound += n;
      }

      appendLog(`[SERVER-BROADCAST] Round #${currentRound} weight parameter broadcast initiated (${currentClients} clients participating).`, 'accent');
      appendLog(`[GRADIENT-REDUCE] Aggregated local tensor weight models across ${currentClients} intersections using FedAvg scalar proportions.`);
      
      const { mae } = computeMetrics(currentRound);
      appendLog(`[FEDAVG-OK] Global round #${currentRound} finalized. Global Test MAE = ${mae} veh/h.`, 'success');
      
      renderState();
    }

    // Client slider change
    sliderClients.addEventListener('input', (e) => {
      currentClients = parseInt(e.target.value, 10);
      labelClients.textContent = `${currentClients} Clients (${Math.round((currentClients / 5) * 100)}% Cohort)`;
      
      // Update visibility/opacity of client cards
      const nodeCards = ['node-card-a', 'node-card-b', 'node-card-c', 'node-card-d', 'node-card-e'];
      nodeCards.forEach((cardId, index) => {
        const card = document.getElementById(cardId);
        if (index < currentClients) {
          card.classList.remove('opacity-30', 'grayscale');
        } else {
          card.classList.add('opacity-30', 'grayscale');
        }
      });

      appendLog(`[TOPOLOGY-UPDATE] Active simulated intersection clients reconfigured to K=${currentClients}.`);
      renderState();
    });

    // Distribution buttons
    distBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        distBtns.forEach(b => {
          b.classList.remove('bg-secondary', 'text-on-secondary', 'shadow-sm');
          b.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        btn.classList.add('bg-secondary', 'text-on-secondary', 'shadow-sm');
        btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

        const dist = btn.getAttribute('data-dist');
        const alphaEl = document.getElementById('metric-alpha-val');
        if (dist === 'iid') {
          currentAlpha = 100.0;
          alphaEl.textContent = 'IID (Uniform)';
          appendLog(`[DISTRIBUTION-MODE] Partition set to IID Uniform (Shuffle split). Earth Mover's Distance -> 0.04.`);
        } else if (dist === 'dirichlet-05') {
          currentAlpha = 0.5;
          alphaEl.textContent = 'α = 0.5';
          appendLog(`[DISTRIBUTION-MODE] Partition recomputed using Dirichlet Dirichlet(α=0.5). Realistic suburban/downtown skew applied.`);
        } else if (dist === 'dirichlet-01') {
          currentAlpha = 0.1;
          alphaEl.textContent = 'α = 0.1';
          appendLog(`[DISTRIBUTION-MODE] Severe Non-IID Dirichlet(α=0.1) configured. High client drift penalty anticipated.`);
        }
        renderState();
      });
    });

    // Seed buttons
    seedBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        seedBtns.forEach(b => {
          b.classList.remove('bg-secondary', 'text-on-secondary', 'font-semibold');
          b.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        btn.classList.add('bg-secondary', 'text-on-secondary', 'font-semibold');
        btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

        currentSeed = parseInt(btn.getAttribute('data-seed'), 10);
        appendLog(`[RNG-SEED] PRNG Seed shifted to ${currentSeed}. Resetting stochastic client mini-batch shuffle orders.`);
        renderState();
      });
    });

    // Controller actions
    btnStep.addEventListener('click', () => stepRound(1));
    btnFf10.addEventListener('click', () => stepRound(10));
    btnFf50.addEventListener('click', () => {
      currentRound = 100;
      appendLog(`[FAST-FORWARD] Evaluated entire 100-round trajectory under current partition and seed ${currentSeed}.`, 'success');
      renderState();
    });

    btnReset.addEventListener('click', () => {
      currentRound = 1;
      appendLog(`[RESET] Simulator restored to Round #1 initial state. Global model initialized with He-normal weights.`);
      renderState();
    });

    btnClearLogs.addEventListener('click', () => {
      terminalEl.innerHTML = '';
      appendLog(`[STREAM-CLEARED] Logging terminal buffer emptied.`);
    });

    // Initial render
    renderState();
  })();
</script></main></div></body></html>