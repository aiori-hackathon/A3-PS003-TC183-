<script>
  function setDirichletPreset(level) {
    const slider = document.getElementById('dirichletSlider');
    const badge = document.getElementById('currentAlphaBadge');
    const display = document.getElementById('sliderValueDisplay');
    const entropy = document.getElementById('entropyScore');
    const emd = document.getElementById('emdScore');
    const divergence = document.getElementById('divergenceScore');

    slider.value = level;

    if (level === 0) {
      badge.textContent = '0.10 (Extreme Non-IID)';
      display.textContent = 'α = 0.10';
      entropy.textContent = '2.48 nats (Severe)';
      emd.textContent = '0.642 μ';
      divergence.textContent = '52.1% Node-3 School';
      badge.className = 'font-label-md text-label-md text-error bg-surface-container-high px-space-xs py-0.5 rounded';
    } else if (level === 1) {
      badge.textContent = '0.50 (Moderate Skew)';
      display.textContent = 'α = 0.50';
      entropy.textContent = '1.84 nats (High)';
      emd.textContent = '0.312 μ';
      divergence.textContent = '34.8% Node-1 Commuter';
      badge.className = 'font-label-md text-label-md text-secondary bg-surface-container-high px-space-xs py-0.5 rounded';
    } else {
      badge.textContent = '∞ (Uniform IID)';
      display.textContent = 'α = ∞';
      entropy.textContent = '0.12 nats (Minimal)';
      emd.textContent = '0.048 μ';
      divergence.textContent = '4.2% Homogeneous';
      badge.className = 'font-label-md text-label-md text-on-tertiary-container bg-surface-container-high px-space-xs py-0.5 rounded';
    }
  }

  document.getElementById('dirichletSlider').addEventListener('input', function(e) {
    setDirichletPreset(parseInt(e.target.value));
  });

  document.getElementById('recomputeWeightsBtn').addEventListener('click', function() {
    const btn = this;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span><span>Computing SGD...</span>';
    btn.disabled = true;
    setTimeout(() => {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }, 850);
  });
</script></main></div></body></html>